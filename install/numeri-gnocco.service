[Unit]
Description=Numeri Gnocco - display ordini
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/numeri-gnocco
ExecStart=/usr/bin/python3 /home/pi/numeri-gnocco/server.py
Environment=PORT=80
# Serve per aprire la porta 80 senza girare da root:
# con la 80 l'indirizzo e' http://gnocco (senza :8080) e funziona il captive portal.
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
