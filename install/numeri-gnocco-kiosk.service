[Unit]
Description=Numeri Gnocco - browser sulla TV
After=numeri-gnocco.service
Wants=numeri-gnocco.service
# Il prompt di login su tty1 tiene la console e impedisce al browser di
# prendersi lo schermo: i due servizi non possono convivere.
Conflicts=getty@tty1.service
After=getty@tty1.service

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/numeri-gnocco
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=HOME=/home/pi
ExecStart=/home/pi/numeri-gnocco/install/kiosk.sh
Restart=always
RestartSec=5
# Serve per disegnare sullo schermo senza X server.
SupplementaryGroups=video render input tty
StandardInput=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes

[Install]
WantedBy=multi-user.target
