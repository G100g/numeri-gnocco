[Unit]
Description=Numeri Gnocco - browser sulla TV
After=numeri-gnocco.service
Wants=numeri-gnocco.service
# Il prompt di login su tty1 tiene la console e impedisce al browser di
# prendersi lo schermo: i due servizi non possono convivere.
Conflicts=getty@tty1.service
After=getty@tty1.service

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/numeri-gnocco
Environment=HOME=/home/pi
# Wayland (cage) e WPE ci mettono i loro socket. Un servizio di sistema non ha
# una sessione logind, quindi /run/user/<uid> potrebbe non esistere: questa la
# crea systemd all'avvio e la cancella allo stop.
Environment=XDG_RUNTIME_DIR=/run/numeri-gnocco
RuntimeDirectory=numeri-gnocco
RuntimeDirectoryMode=0700
ExecStart=/home/pi/numeri-gnocco/install/kiosk.sh
Restart=always
RestartSec=5
# video/render/input/tty: disegnare sullo schermo senza X server.
# audio: l'uscita HDMI, altrimenti il campanello non si sente.
SupplementaryGroups=video render input tty audio
StandardInput=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes

[Install]
WantedBy=multi-user.target
